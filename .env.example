# Optional Hugging Face token. Required if the container cannot access the gated
# Llama tokenizer from an already-authorized local cache.
HF_TOKEN=

# Studio bind port on the host.
PORT=7860

# Native macOS defaults to mps/float16 when available. Docker is CPU by default
# unless you adapt the image/runtime for CUDA on Linux.
MISO_TTS_DEVICE=auto
MISO_TTS_DTYPE=auto
MISO_TTS_AUTOLOAD=0
